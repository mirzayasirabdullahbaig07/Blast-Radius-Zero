[Unit]
Description=Blast Radius Zero (FastAPI)
After=network.target docker.service
Requires=docker.service

[Service]
User=brz
Group=brz
WorkingDirectory=/opt/blast-radius-zero
EnvironmentFile=/opt/blast-radius-zero/.env
ExecStart=/opt/blast-radius-zero/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
