# Paste this (with your real key) into Streamlit Cloud > App settings > Secrets
# Option A - Groq (free, works today)
VULTR_INFERENCE_API_KEY = "gsk_your_groq_key"
VULTR_INFERENCE_BASE_URL = "https://api.groq.com/openai/v1"
VULTR_MODEL = "llama-3.3-70b-versatile"

# Option B - Vultr Serverless Inference (when you have credits)
# VULTR_INFERENCE_API_KEY = "your_vultr_key"
# VULTR_INFERENCE_BASE_URL = "https://api.vultrinference.com/v1"
# VULTR_MODEL = "Qwen2.5-Coder-32B-Instruct"
